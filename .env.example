# Public URL baked into the static frontend. Local API runs with npm run dev:api.
NEXT_PUBLIC_ARTICLE_API_URL=http://localhost:3001/api/article-engagement

# SERVER ONLY. Copy connection strings from Supabase > Connect, URL-encoding passwords.
# Runtime: transaction pooler (port 6543). Never use NEXT_PUBLIC_ for database secrets.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Migrations: direct connection, or session pooler (5432) when IPv6 is unavailable.
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
ARTICLE_ALLOWED_ORIGINS=http://localhost:3000,https://antoniovita.me,https://www.antoniovita.me
# Generate with: openssl rand -hex 32
ENGAGEMENT_SECRET=
